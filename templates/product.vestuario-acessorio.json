        "custom_liquid_eBAkpz": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign valor_giftback = product.price | times: 10 | divided_by: 100 %}\n\n<div\n  class=\"tn-giftback-badge\"\n  data-tn-giftback\n  data-unit-price=\"{{ product.price }}\"\n>\n  <div class=\"tn-giftback-badge__icon\" aria-hidden=\"true\">\n    <svg\n      width=\"20\"\n      height=\"20\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      <path\n        d=\"M20 12V22H4V12\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      />\n\n      <path\n        d=\"M2 7H22V12H2V7Z\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linejoin=\"round\"\n      />\n\n      <path\n        d=\"M12 7V22\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linecap=\"round\"\n      />\n\n      <path\n        d=\"M12 7H8.5C7.11929 7 6 5.88071 6 4.5C6 3.11929 7.11929 2 8.5 2C11 2 12 7 12 7Z\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linejoin=\"round\"\n      />\n\n      <path\n        d=\"M12 7H15.5C16.8807 7 18 5.88071 18 4.5C18 3.11929 16.8807 2 15.5 2C13 2 12 7 12 7Z\"\n        stroke=\"currentColor\"\n        stroke-width=\"1.5\"\n        stroke-linejoin=\"round\"\n      />\n    </svg>\n  </div>\n\n  <div class=\"tn-giftback-badge__text\">\n    Ganhe\n    <strong data-tn-giftback-value>\n      {{ valor_giftback | money }}\n    </strong>\n    de giftback nessa compra\n  </div>\n</div>\n\n<style>\n  .tn-giftback-badge {\n    box-sizing: border-box;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    width: fit-content;\n    max-width: 100%;\n    margin: 16px 0;\n    padding: 12px 24px 12px 14px;\n    color: #2d2a24;\n    background: #fbfaf7;\n    border: 1px solid #e8e1d2;\n    border-radius: 999px;\n    box-shadow: 0 6px 18px rgba(51, 42, 22, 0.05);\n  }\n\n  .tn-giftback-badge__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 36px;\n    width: 36px;\n    height: 36px;\n    color: #846c27;\n    background: #f1ecdf;\n    border-radius: 50%;\n  }\n\n  .tn-giftback-badge__text {\n    min-width: 0;\n    padding-right: 2px;\n    color: #2d2a24;\n    font-size: 14px;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n\n  .tn-giftback-badge__text strong {\n    color: #745b16;\n    font-size: 17px;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tn-giftback-badge {\n      display: flex;\n      gap: 10px;\n      width: 100%;\n      max-width: 100%;\n      padding: 10px 18px 10px 10px;\n    }\n\n    .tn-giftback-badge__icon {\n      flex: 0 0 32px;\n      width: 32px;\n      height: 32px;\n    }\n\n    .tn-giftback-badge__icon svg {\n      width: 17px;\n      height: 17px;\n    }\n\n    .tn-giftback-badge__text {\n      flex: 1;\n      padding-right: 2px;\n      font-size: 13px;\n      line-height: 1.2;\n      white-space: nowrap;\n    }\n\n    .tn-giftback-badge__text strong {\n      font-size: 15px;\n    }\n  }\n\n  @media screen and (max-width: 380px) {\n    .tn-giftback-badge {\n      gap: 8px;\n      padding: 9px 14px 9px 9px;\n    }\n\n    .tn-giftback-badge__icon {\n      flex-basis: 30px;\n      width: 30px;\n      height: 30px;\n    }\n\n    .tn-giftback-badge__text {\n      font-size: 12px;\n    }\n\n    .tn-giftback-badge__text strong {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const giftbackBlock = document.querySelector('[data-tn-giftback]');\n\n    if (!giftbackBlock) return;\n\n    const valueElement = giftbackBlock.querySelector(\n      '[data-tn-giftback-value]'\n    );\n\n    const unitPriceInCents = Number(\n      giftbackBlock.dataset.unitPrice\n    );\n\n    const productArea =\n      giftbackBlock.closest('section') ||\n      giftbackBlock.closest('.shopify-section') ||\n      document;\n\n    const formatCurrency = valueInCents => {\n      return new Intl.NumberFormat('pt-BR', {\n        style: 'currency',\n        currency: 'BRL'\n      }).format(valueInCents / 100);\n    };\n\n    const getQuantityInput = () => {\n      return (\n        productArea.querySelector(\n          'form[action*=\"/cart/add\"] input[name=\"quantity\"]'\n        ) ||\n        productArea.querySelector('input[name=\"quantity\"]') ||\n        productArea.querySelector('quantity-input input')\n      );\n    };\n\n    const updateGiftback = () => {\n      const quantityInput = getQuantityInput();\n\n      const quantity = Math.max(\n        1,\n        parseInt(quantityInput?.value, 10) || 1\n      );\n\n      const totalGiftbackInCents = Math.round(\n        unitPriceInCents * quantity * 0.1\n      );\n\n      valueElement.textContent = formatCurrency(\n        totalGiftbackInCents\n      );\n    };\n\n    productArea.addEventListener('input', event => {\n      if (\n        event.target.matches(\n          'input[name=\"quantity\"], quantity-input input'\n        )\n      ) {\n        updateGiftback();\n      }\n    });\n\n    productArea.addEventListener('change', event => {\n      if (\n        event.target.matches(\n          'input[name=\"quantity\"], quantity-input input'\n        )\n      ) {\n        updateGiftback();\n      }\n    });\n\n    productArea.addEventListener('click', event => {\n      const quantityButton = event.target.closest(\n        'quantity-input button, .quantity button, button[name=\"plus\"], button[name=\"minus\"]'\n      );\n\n      if (!quantityButton) return;\n\n      window.setTimeout(updateGiftback, 50);\n    });\n\n    updateGiftback();\n  })();\n</script>"
          }
        },
