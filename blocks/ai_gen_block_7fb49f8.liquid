            <rect x="3" y="6" width="18" height="15" rx="2"/>
            <path d="M3 10h18"/>
            <path d="M9 14h.01M12 14h.01M15 14h.01M9 17h.01M12 17h.01M15 17h.01"/>
          </svg>
        {% endif %}
      </div>
      <div class="ai-trust-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_2_text }}
      </div>
    </div>

    <div class="ai-trust-badge-item-{{ ai_gen_id }}">
      <div class="ai-trust-badge-icon-{{ ai_gen_id }}">
        {% if block.settings.badge_3_icon %}
          <img 
            src="{{ block.settings.badge_3_icon | image_url: width: 200 }}" 
            alt="{{ block.settings.badge_3_text }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 2a3 3 0 0 0-3 3v1a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3V5a3 3 0 0 0-3-3z"/>
            <circle cx="12" cy="14" r="2"/>
          </svg>
        {% endif %}
      </div>
      <div class="ai-trust-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_3_text }}
      </div>
    </div>

    <div class="ai-trust-badge-item-{{ ai_gen_id }}">
      <div class="ai-trust-badge-icon-{{ ai_gen_id }}">
        {% if block.settings.badge_4_icon %}
          <img 
            src="{{ block.settings.badge_4_icon | image_url: width: 200 }}" 
            alt="{{ block.settings.badge_4_text }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <rect x="3" y="8" width="18" height="12" rx="2"/>
            <path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/>
            <path d="M12 12v4"/>
            <path d="M8 16h8"/>
          </svg>
        {% endif %}
      </div>
      <div class="ai-trust-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_4_text }}
      </div>
    </div>

    <div class="ai-trust-badge-item-{{ ai_gen_id }}">
      <div class="ai-trust-badge-icon-{{ ai_gen_id }}">
        {% if block.settings.badge_5_icon %}
          <img 
            src="{{ block.settings.badge_5_icon | image_url: width: 200 }}" 
            alt="{{ block.settings.badge_5_text }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        {% endif %}
      </div>
      <div class="ai-trust-badge-text-{{ ai_gen_id }}">
        {{ block.settings.badge_5_text }}
      </div>
    </div>

  </div>
</div>

