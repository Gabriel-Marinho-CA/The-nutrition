{% comment %}
  Renders cart drawer (mini cart)

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'component-cart-drawer-base.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-input.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<script>
  window.buyXGetYEnabled =
    window.buyXGetYEnabled ||
    {{ settings.buy_x_get_y_enabled | default: false | json }};

  window.bxgyIsCumulative =
    window.bxgyIsCumulative ||
    {{ settings.buy_x_get_y_cumulative | default: false | json }};
</script>

{%- liquid
  assign btn_bg = settings['color-button-primary-background'] | default: '#000000'
  assign btn_text = settings['color-button-primary-text'] | default: '#ffffff'

  assign tn_amp_total_discount = 0
  assign tn_amp_checkout_total = cart.total_price
  assign tn_has_amp_discount = false

  for cart_item in cart.items
    assign tn_amp_percent = cart_item.properties['_tn_amp_discount_percent'] | default: 0 | plus: 0

    if tn_amp_percent > 0
      assign tn_has_amp_discount = true

      assign tn_amp_multiplier = 100 | minus: tn_amp_percent
      assign tn_amp_unit_numerator = cart_item.final_price | times: tn_amp_multiplier
      assign tn_amp_unit_numerator = tn_amp_unit_numerator | plus: 50
      assign tn_amp_unit_price = tn_amp_unit_numerator | divided_by: 100

      assign tn_amp_line_price = tn_amp_unit_price | times: cart_item.quantity
      assign tn_amp_line_discount = cart_item.final_line_price | minus: tn_amp_line_price

      if tn_amp_line_discount > 0
        assign tn_amp_total_discount = tn_amp_total_discount | plus: tn_amp_line_discount
      endif
    endif
  endfor

  assign tn_amp_checkout_total = cart.total_price | minus: tn_amp_total_discount

  if tn_amp_checkout_total < 0
    assign tn_amp_checkout_total = 0
  endif
-%}

{% style %}
  cart-drawer {
    --color-foreground: var(--color-text-rgb, 18, 18, 18);
    --color-background: var(--color-background-rgb, 255, 255, 255);
    --color-button:
      {{ btn_bg | color_extract: 'red' }},
      {{ btn_bg | color_extract: 'green' }},
      {{ btn_bg | color_extract: 'blue' }};
    --color-button-text:
      {{ btn_text | color_extract: 'red' }},
      {{ btn_text | color_extract: 'green' }},
      {{ btn_text | color_extract: 'blue' }};
    --font-body-scale: 1;
    --font-heading-scale: 1;
    --inputs-radius: var(--border-radius, 4px);
    --buttons-radius: var(--border-radius-button, 4px);
  }

  .drawer {
    visibility: hidden;
  }

  .tn-amp-price {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
  }

  .tn-amp-price__original {
    color: rgba(var(--color-foreground), 0.58);
    font-size: 12px;
    text-decoration: line-through;
  }

  .tn-amp-price__discounted {
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }

  .tn-amp-discount-label {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 5px;
    padding: 3px 8px;
    color: #8c6729;
    background: #faf5ec;
    border: 1px solid #e5d2ad;
    border-radius: 999px;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 700;
  }

  .tn-amp-cart-summary {
    display: grid;
    width: 100%;
    gap: 8px;
  }

  .tn-amp-cart-summary__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: rgba(var(--color-foreground), 0.72);
    font-size: 13px;
    line-height: 1.35;
  }

  .tn-amp-cart-summary__row--discount {
    color: #8c6729;
    font-weight: 650;
  }

  .tn-amp-cart-summary__total {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-top: 2px;
    padding-top: 11px;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
  }

  .tn-amp-cart-summary__total-label,
  .tn-amp-cart-summary__total-value {
    margin: 0;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 700;
  }

  .tn-amp-cart-summary__total-content {
    text-align: right;
  }

  .tn-amp-cart-summary__note {
    margin: 3px 0 0;
    color: rgba(var(--color-foreground), 0.58);
    font-size: 11px;
    line-height: 1.35;
  }
{% endstyle %}

<cart-drawer
  class="drawer{% if cart == empty %} is-empty{% endif %}"
  data-cart-type="drawer"
>
  <div id="CartDrawer" class="cart-drawer">
    <div
      id="CartDrawer-Overlay"
      class="cart-drawer__overlay"
    ></div>

    <div
      class="drawer__inner gradient"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">
                {{ 'sections.cart.empty' | t }}
              </h2>

              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>

              <a
                href="{{ routes.all_products_collection_url }}"
                class="button"
              >
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled
                and customer == null
              -%}
                <p class="cart__login-title h3">
                  {{ 'sections.cart.login.title' | t }}
                </p>

                <p class="cart__login-paragraph">
                  {{
                    'sections.cart.login.paragraph_html'
                    | t: link: routes.account_login_url
                  }}
                </p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__header">
        <h2 class="drawer__heading">
          {{ 'sections.cart.title' | t }}
        </h2>

        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      {% render 'shipping-bar' %}

      <cart-drawer-items
        {% if cart == empty %}
          class="is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div
            id="CartDrawer-CartItems"
            class="drawer__contents js-contents"
          >
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table
                  class="cart-items"
                  role="table"
                >
                  <thead role="rowgroup">
                    <tr role="row">
                      <th
                        id="CartDrawer-ColumnProductImage"
                        role="columnheader"
                      >
                        <span class="visually-hidden">
                          {{ 'sections.cart.headings.image' | t }}
                        </span>
                      </th>

                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>

                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>

                      <th
                        id="CartDrawer-ColumnQuantity"
                        role="columnheader"
                      >
                        <span class="visually-hidden">
                          {{ 'sections.cart.headings.quantity' | t }}
                        </span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- for item in cart.items -%}
                      {%- liquid
                        assign has_qty_rules = false

                        if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                          assign has_qty_rules = true
                        endif

                        assign has_vol_pricing = false

                        if item.variant.quantity_price_breaks.size > 0
                          assign has_vol_pricing = true
                        endif

                        assign title_downcased = item.product.title | downcase
                        assign is_gift = false

                        if item.properties['_brinde'] != blank
                          assign is_gift = true
                        elsif title_downcased contains 'brinde'
                          assign is_gift = true
                        endif

                        assign tn_item_amp_percent = item.properties['_tn_amp_discount_percent'] | default: 0 | plus: 0
                        assign tn_item_has_amp_discount = false
                        assign tn_item_amp_unit_price = item.final_price
                        assign tn_item_amp_line_price = item.final_line_price

                        if tn_item_amp_percent > 0
                          assign tn_item_has_amp_discount = true
                          assign tn_item_amp_multiplier = 100 | minus: tn_item_amp_percent

                          assign tn_item_amp_unit_numerator = item.final_price | times: tn_item_amp_multiplier
                          assign tn_item_amp_unit_numerator = tn_item_amp_unit_numerator | plus: 50
                          assign tn_item_amp_unit_price = tn_item_amp_unit_numerator | divided_by: 100

                          assign tn_item_amp_line_price = tn_item_amp_unit_price | times: item.quantity
                        endif
                      -%}

                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}{% if is_gift %} cart-item--gift{% endif %}"
                        role="row"
                      >
                        <td
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {% if item.image %}
                            <a
                              {% unless is_gift %}
                                href="{{ item.url }}"
                              {% endunless %}
                              class="cart-item__link"
                              tabindex="-1"
                              aria-hidden="true"
                            ></a>

                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td
                          class="cart-item__details"
                          role="cell"
                          headers="CartDrawer-ColumnProduct"
                        >
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">
                              {{ item.product.vendor }}
                            </p>
                          {%- endif -%}

                          <a
                            {% unless is_gift %}
                              href="{{ item.url }}"
                            {% endunless %}
                            class="cart-item__name h4 break"
                          >
                            {{- item.product.title | escape -}}
                          </a>

                          {%- if is_gift -%}
                            <p>
                              - {{ item.quantity }}x
                              BRIND{% if item.quantity > 1 %}ES{% else %}E{% endif %} -
                            </p>
                          {%- else -%}
                            <div class="product-option">
                              <div
                                class="cart-item__totals"
                                role="cell"
                                headers="CartDrawer-ColumnTotal"
                              >
                                {%- render 'loading-spinner' -%}

                                <div class="cart-item__price-wrapper">
                                  {%- if tn_item_has_amp_discount -%}
                                    <div class="tn-amp-price">
                                      <s class="tn-amp-price__original">
                                        {{ item.final_line_price | money }}
                                      </s>

                                      <span class="tn-amp-price__discounted">
                                        {{ tn_item_amp_line_price | money }}
                                      </span>
                                    </div>

                                    <span class="tn-amp-discount-label">
                                      AMP · {{ tn_item_amp_percent }}% OFF
                                    </span>
                                  {%- elsif item.original_line_price != item.final_line_price -%}
                                    <div class="cart-item__discounted-prices">
                                      <span class="visually-hidden">
                                        {{ 'products.product.price.regular_price' | t }}
                                      </span>

                                      <s class="cart-item__old-price price price--end">
                                        {{ item.original_line_price | money }}
                                      </s>

                                      <span class="visually-hidden">
                                        {{ 'products.product.price.sale_price' | t }}
                                      </span>

                                      <span class="price price--end">
                                        {{ item.final_line_price | money }}
                                      </span>
                                    </div>
                                  {%- else -%}
                                    <span class="price price--end">
                                      {{ item.original_line_price | money }}
                                    </span>
                                  {%- endif -%}

                                  {%- if item.variant.available
                                    and item.unit_price_measurement
                                  -%}
                                    {% render 'unit-price',
                                      price: item.unit_price,
                                      measurement: item.unit_price_measurement
                                    %}
                                  {%- endif -%}
                                </div>
                              </div>

                              <div
                                class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                                role="cell"
                                headers="CartDrawer-ColumnQuantity"
                              >
                                <quantity-popover>
                                  <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                                    <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                      <quantity-input class="quantity cart-quantity">
                                        <button
                                          class="quantity__button"
                                          name="minus"
                                          type="button"
                                          {% if item.instructions
                                            and item.instructions.can_update_quantity == false
                                          %}
                                            disabled
                                          {% endif %}
                                        >
                                          <span class="visually-hidden">
                                            {{
                                              'products.product.quantity.decrease'
                                              | t: product: item.product.title
                                              | escape
                                            }}
                                          </span>

                                          <span class="svg-wrapper">
                                            {{- 'icon-minus.svg' | inline_asset_content -}}
                                          </span>
                                        </button>

                                        <input
                                          class="quantity__input"
                                          type="number"
                                          data-quantity-variant-id="{{ item.variant.id }}"
                                          name="updates[]"
                                          value="{{ item.quantity }}"
                                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                          min="0"
                                          data-min="{{ item.variant.quantity_rule.min }}"
                                          {% if item.variant.quantity_rule.max != null %}
                                            max="{{ item.variant.quantity_rule.max }}"
                                          {% endif %}
                                          step="{{ item.variant.quantity_rule.increment }}"
                                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                          data-index="{{ item.index | plus: 1 }}"
                                          {% if item.instructions
                                            and item.instructions.can_update_quantity == false
                                          %}
                                            disabled
                                          {% endif %}
                                        >

                                        <button
                                          class="quantity__button"
                                          name="plus"
                                          type="button"
                                          {% if item.instructions
                                            and item.instructions.can_update_quantity == false
                                          %}
                                            disabled
                                          {% endif %}
                                        >
                                          <span class="visually-hidden">
                                            {{
                                              'products.product.quantity.increase'
                                              | t: product: item.product.title
                                              | escape
                                            }}
                                          </span>

                                          <span class="svg-wrapper">
                                            {{- 'icon-plus.svg' | inline_asset_content -}}
                                          </span>
                                        </button>
                                      </quantity-input>
                                    </div>

                                    <cart-remove-button
                                      id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                      data-index="{{ item.index | plus: 1 }}"
                                    >
                                      <button
                                        type="button"
                                        class="button button--tertiary cart-remove-button{% if item.instructions and item.instructions.can_remove == false %} hidden{% endif %}"
                                        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                        data-variant-id="{{ item.variant.id }}"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-remove.svg' | inline_asset_content -}}
                                        </span>
                                      </button>
                                    </cart-remove-button>
                                  </div>

                                  <div
                                    id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                                    class="cart-item__error"
                                    role="alert"
                                  >
                                    <small class="cart-item__error-text"></small>

                                    <span class="svg-wrapper">
                                      {{- 'icon-error.svg' | inline_asset_content -}}
                                    </span>
                                  </div>
                                </quantity-popover>
                              </div>
                            </div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>

                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}

                                {%- if property.last != blank
                                  and property_first_char != '_'
                                -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>

                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">
                              {{ item.selling_plan_allocation.selling_plan.name }}
                            </p>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {{ discount.discount_application.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}

            <p
              id="CartDrawer-LiveRegionText"
              class="visually-hidden"
              role="status"
            ></p>

            <p
              id="CartDrawer-LineItemStatus"
              class="visually-hidden"
              aria-hidden="true"
              role="status"
            >
              {{ 'accessibility.loading' | t }}
            </p>
          </div>

          <div
            id="CartDrawer-CartErrors"
            role="alert"
          ></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer">
        {% if cart.empty? == false %}
          {% render 'order_bump' %}
        {% endif %}

        {% assign giftback_carrinho = tn_amp_checkout_total | times: 10 | divided_by: 100 %}

        <div class="tn-cart-giftback">
          <div
            class="tn-cart-giftback__icon"
            aria-hidden="true"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M20 12V22H4V12"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <path
                d="M2 7H22V12H2V7Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />

              <path
                d="M12 7V22"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

              <path
                d="M12 7H8.5C7.11929 7 6 5.88071 6 4.5C6 3.11929 7.11929 2 8.5 2C11 2 12 7 12 7Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />

              <path
                d="M12 7H15.5C16.8807 7 18 5.88071 18 4.5C18 3.11929 16.8807 2 15.5 2C13 2 12 7 12 7Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div class="tn-cart-giftback__text">
            Ganhe
            <strong>
              {{ giftback_carrinho | money }}
            </strong>
            de giftback nessa compra
          </div>
        </div>

        <style>
          .tn-cart-giftback {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            margin: 14px 0 16px;
            padding: 11px 18px 11px 11px;
            color: #2d2a24;
            background: #fbfaf7;
            border: 1px solid #e8e1d2;
            border-radius: 999px;
            box-shadow: 0 6px 18px rgba(51, 42, 22, 0.05);
          }

          .tn-cart-giftback__icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            color: #846c27;
            background: #f1ecdf;
            border-radius: 50%;
          }

          .tn-cart-giftback__text {
            min-width: 0;
            color: #2d2a24;
            font-size: 13px;
            line-height: 1.25;
          }

          .tn-cart-giftback__text strong {
            color: #745b16;
            font-size: 15px;
            font-weight: 700;
            white-space: nowrap;
          }

          @media screen and (max-width: 380px) {
            .tn-cart-giftback {
              gap: 8px;
              padding: 9px 14px 9px 9px;
            }

            .tn-cart-giftback__icon {
              flex: 0 0 30px;
              width: 30px;
              height: 30px;
            }

            .tn-cart-giftback__icon svg {
              width: 16px;
              height: 16px;
            }

            .tn-cart-giftback__text {
              font-size: 12px;
            }

            .tn-cart-giftback__text strong {
              font-size: 14px;
            }
          }
        </style>

        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>

            <cart-note class="cart__note field">
              <label
                class="visually-hidden"
                for="CartDrawer-Note"
              >
                {{ 'sections.cart.note' | t }}
              </label>

              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <div class="cart-drawer__footer">
          <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul
                class="discounts list-unstyled"
                role="list"
                aria-label="{{ 'customer.order.discount' | t }}"
              >
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {{- 'icon-discount.svg' | inline_asset_content -}}

                    {{ discount.title | escape }}

                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- if tn_has_amp_discount
            and tn_amp_total_discount > 0
          -%}
            <div
              class="tn-amp-cart-summary"
              role="status"
            >
              <div class="tn-amp-cart-summary__row">
                <span>Subtotal</span>

                <span>
                  {{ cart.total_price | money }}
                </span>
              </div>

              <div class="tn-amp-cart-summary__row tn-amp-cart-summary__row--discount">
                <span>Descontos AMP</span>

                <span>
                  -{{ tn_amp_total_discount | money }}
                </span>
              </div>

              <div class="tn-amp-cart-summary__total">
                <span class="tn-amp-cart-summary__total-label">
                  Total
                </span>

                <div class="tn-amp-cart-summary__total-content">
                  <p class="tn-amp-cart-summary__total-value">
                    {{ tn_amp_checkout_total | money }}
                  </p>

                  <p class="tn-amp-cart-summary__note">
                    Desconto aplicado no checkout da Yampi
                  </p>
                </div>
              </div>
            </div>
          {%- else -%}
            <div
              class="totals"
              role="status"
            >
              <h2 class="totals__total">
                Total
              </h2>

              <div class="wrapper-totals-price">
                <p class="totals__total-value">
                  {{ cart.total_price | money }}
                </p>

                {% render 'res-installments' %}
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="cart__ctas">
          <a
            href="/cart"
            id="CartDrawer-Checkout"
            class="cart__checkout-button button"
            name="checkout"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ 'sections.cart.checkout' | t }}
          </a>

          <a
            onclick="this.closest('cart-drawer').close()"
            class="keep-buying"
            href="#"
          >
            Continuar comprando
          </a>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>