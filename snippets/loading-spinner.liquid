{% comment %}
  Renders loading-spinner.
  Accepts:
    - class: {string} css classes to replace the default ones (optional)

  Usage:
  {% render 'loading-spinner' %}
{% endcomment %}

{% comment %}
  `loading-overlay` é a classe que o cart.js deste tema procura para
  mostrar/esconder o spinner; `loading__spinner` é a do CSS do drawer.
{% endcomment %}
<div class="{% if class %}{{ class }}{% else %}loading__spinner loading-overlay hidden{% endif %}">
  {{ 'loading-spinner.svg' | inline_asset_content }}
</div>
