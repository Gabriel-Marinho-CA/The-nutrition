{%- comment -%}
  Barra de promoção com cronômetro e janela de vigência (início + fim).

  A barra só aparece dentro do período configurado: some sozinha antes de
  começar (a menos que a contagem de aquecimento esteja ligada) e desaparece
  no segundo em que a promoção termina, sem precisar de publicação manual.
{%- endcomment -%}

{{ 'promo-countdown-bar.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  As datas vão cruas para o HTML e quem interpreta é o new Date() do navegador.
  Tentar converter para timestamp aqui no Liquid derrubava a seção inteira
  quando o filtro date não engolia o formato.
{%- endcomment -%}

{%- liquid
  assign bg = section.settings.background_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign unit_bg = section.settings.timer_background_color
  assign cta_bg = section.settings.cta_background_color | default: '#ffffff'
  assign cta_text = section.settings.cta_text_color | default: '#000000'
-%}

{%- comment -%}
  data-state controla o display: none (antes) -> block (durante) -> none
  (depois). Começa em "init" para que o CSS mantenha display:none até o JS
  decidir a fase, sem piscar a barra na tela.
{%- endcomment -%}
<promo-countdown-bar
  class="wt-promo-bar__wrapper"
  data-state="init"
  data-section-id="{{ section.id }}"
  data-start="{{ section.settings.start_date | escape }}"
  data-end="{{ section.settings.end_date | escape }}"
  data-preview="{% if request.design_mode %}true{% else %}false{% endif %}"
  data-mode="{{ section.settings.visibility_mode }}"
  data-force-state="{% if request.design_mode %}{{ section.settings.preview_state }}{% else %}auto{% endif %}"
  data-show-before="{{ section.settings.show_before_start }}"
  data-text-active="{{ section.settings.message | escape }}"
  data-text-before="{{ section.settings.message_before | escape }}"
  data-label-days="{{ section.settings.label_days | escape }}"
  data-label-hours="{{ section.settings.label_hours | escape }}"
  data-label-minutes="{{ section.settings.label_minutes | escape }}"
  data-label-seconds="{{ section.settings.label_seconds | escape }}"
>
  <div
    class="wt-promo-bar"
    data-sticky="{{ section.settings.sticky }}"
    data-timer-style="{{ section.settings.timer_style }}"
    role="region"
    aria-label="{{ section.settings.message | escape }}"
    style="
      --wt-promo-bar-bg: {{ bg }};
      --wt-promo-bar-text: {{ text_color }};
      --wt-promo-bar-cta-bg: {{ cta_bg }};
      --wt-promo-bar-cta-text: {{ cta_text }};
      --wt-promo-bar-scale: {{ section.settings.scale_desktop | divided_by: 100.0 }};
      --wt-promo-bar-scale-mobile: {{ section.settings.scale_mobile | divided_by: 100.0 }};
      {%- if unit_bg != blank and unit_bg != 'transparent' -%}
        --wt-promo-bar-unit-bg: {{ unit_bg }};
      {%- endif -%}
    "
  >
    <div class="wt-promo-bar__inner">
      <span class="wt-promo-bar__message">{{ section.settings.message }}</span>

      {%- comment -%} Preenchido pelo componente a cada segundo. {%- endcomment -%}
      <span class="wt-promo-bar__timer" role="timer" aria-live="off"></span>

      {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
        <a class="wt-promo-bar__cta" href="{{ section.settings.cta_link }}">
          {{- section.settings.cta_text -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_close -%}
      <button
        type="button"
        class="wt-promo-bar__close"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {%- render 'icon-close' -%}
      </button>
    {%- endif -%}
  </div>
</promo-countdown-bar>

{%- comment -%}
  Nas fases ocultas o editor mostraria uma seção vazia, que parece defeito.
  Este aviso existe só dentro do editor e nunca vai para a loja.
{%- endcomment -%}
{%- if request.design_mode and section.settings.visibility_mode != 'always' -%}
  {%- liquid
    assign hidden_phase = false
    if section.settings.preview_state == 'ended'
      assign hidden_phase = true
    endif
    if section.settings.preview_state == 'before' and section.settings.show_before_start == false
      assign hidden_phase = true
    endif
  -%}
  {%- if hidden_phase -%}
    <div class="wt-promo-bar__note">
      Nesta fase a barra fica oculta (display: none) — na loja não aparece nada aqui.
    </div>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Aviso de data inválida: o JS preenche este bloco. Fica só no editor.
{%- endcomment -%}
{%- if request.design_mode -%}
  <div class="wt-promo-bar__error" data-promo-bar-error="{{ section.id }}"></div>
{%- endif -%}

<script src="{{ 'promo-countdown-bar.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Barra promocional",
  "tag": "section",
  "class": "wt-shopify-section wt-promo-bar-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A barra aparece sozinha no início e some sozinha no fim do período. Não precisa publicar nem despublicar nada no domingo."
    },
    {
      "type": "header",
      "content": "Período da promoção"
    },
    {
      "type": "text",
      "id": "start_date",
      "label": "Início",
      "info": "Formato AAAA-MM-DD HH:MM (ex.: 2026-08-23 00:01).",
      "default": "2026-08-23 00:01",
      "placeholder": "AAAA-MM-DD HH:MM"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Fim",
      "info": "Formato AAAA-MM-DD HH:MM:SS. Use 23:59:59 para valer até o último segundo do dia.",
      "default": "2026-08-25 23:59:59",
      "placeholder": "AAAA-MM-DD HH:MM:SS"
    },
    {
      "type": "checkbox",
      "id": "show_before_start",
      "label": "Mostrar contagem antes de começar",
      "info": "Liga a barra de aquecimento (\"começa em...\") antes do início.",
      "default": false
    },
    {
      "type": "header",
      "content": "Exibição"
    },
    {
      "type": "select",
      "id": "visibility_mode",
      "label": "Quando exibir",
      "info": "No modo automático a barra fica oculta (display: none) antes do início, visível (display: block) durante a promoção e some de novo (display: none) quando acabar.",
      "options": [
        { "value": "window", "label": "Somente durante a promoção (automático)" },
        { "value": "always", "label": "Sempre visível (ignora as datas)" }
      ],
      "default": "window"
    },
    {
      "type": "select",
      "id": "preview_state",
      "label": "Pré-visualizar fase",
      "info": "Só funciona aqui dentro do editor de tema — a loja publicada sempre usa a fase real. Use para conferir como cada momento vai ficar.",
      "options": [
        { "value": "auto", "label": "Fase real (pela data de hoje)" },
        { "value": "before", "label": "Antes de começar" },
        { "value": "active", "label": "Durante a promoção" },
        { "value": "ended", "label": "Depois de acabar" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Mensagem durante a promoção",
      "default": "PROMOÇÃO EM TODO O SITE — TERMINA EM"
    },
    {
      "type": "text",
      "id": "message_before",
      "label": "Mensagem antes de começar",
      "default": "A PROMOÇÃO COMEÇA EM",
      "visible_if": "{{ section.settings.show_before_start }}"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Rótulo dias",
      "default": "dias"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Rótulo horas",
      "default": "hrs"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Rótulo minutos",
      "default": "min"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Rótulo segundos",
      "default": "seg"
    },
    {
      "type": "header",
      "content": "Botão"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto do botão",
      "default": "Ver ofertas"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link do botão"
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "timer_style",
      "label": "Estilo do cronômetro",
      "options": [
        { "value": "boxed", "label": "Com caixas e rótulos" },
        { "value": "plain", "label": "Simples (00:00:00)" }
      ],
      "default": "boxed"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Fixar no topo ao rolar",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Permitir fechar",
      "info": "Fica fechada até o visitante abrir o site de novo.",
      "default": false
    },
    {
      "type": "range",
      "id": "scale_desktop",
      "label": "Tamanho no desktop",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "scale_mobile",
      "label": "Tamanho no mobile",
      "min": 60,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fundo da barra",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "timer_background_color",
      "label": "Fundo dos números",
      "info": "Deixe vazio para usar um branco translúcido."
    },
    {
      "type": "color",
      "id": "cta_background_color",
      "label": "Fundo do botão",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Texto do botão",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Barra promocional"
    }
  ]
}
{% endschema %}
